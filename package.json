{
  "name": "typetrack-desktop",
  "version": "2.0.1",
  "description": "TypeTrack - Typing Performance Tracker Desktop App",
  "main": "main.js",
  "author": "Vineet Sharma",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never",
    "build:portable": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.vineetsharma.typetrack",
    "productName": "TypeTrack",
    "asar": true,
    "files": [
      "index.html",
      "style.css",
      "script.js",
      "main.js",
      "LICENSE.txt"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}